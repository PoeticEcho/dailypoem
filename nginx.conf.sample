# ==============================================================================
# 감성 타이핑 시집 (Daily Poem) - Nginx 가상 호스트 설정 예시
# ==============================================================================

server {
    listen 80;
    server_name your-poetry-domain.com; # 사용자 도메인으로 변경

    root /var/www/dailypoem; # 실제 업로드된 디렉토리 경로
    index index.html;

    # 1. 404 에러 발생 시 404.html로 전달 (Clean URL /2341/ 자동 파싱 및 리다이렉트)
    error_page 404 /404.html;

    location / {
        try_files $uri $uri/ /404.html;
    }

    # 2. 5대 정예 로컬 서체 및 JSON, 이미지 브라우저 캐싱
    location ~* \.(woff2|png|ico|json)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # 3. HTML 파일은 캐시 없이 항상 최신 반영
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
}
